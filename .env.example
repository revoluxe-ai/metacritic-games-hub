# Database (SQLite used when DATABASE_URL unset in local dev without Docker)
DATABASE_URL=postgresql://metacritic:metacritic@db:5432/metacritic

# Metacritic (public web API key used by Metacritic frontend)
METACRITIC_API_KEY=1MOZgmNFxvmljaQR1X9KAij9Mo4xAY3u

# OpenAI-compatible LLM (default: Google Gemini). Heuristic summaries when LLM_API_KEY unset.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# LLM_MAX_RETRIES=3
# LLM_RETRY_BACKOFF_SECONDS=2.0
# LLM_REQUEST_DELAY_SECONDS=0.75

# Worker / scheduler
GAMES_PER_RUN=20
SCHEDULER_INTERVAL_MINUTES=60
SCRAPER_ENABLED=true
RUN_SCHEDULER=false
RUN_INGESTION_ON_STARTUP=false
YOUTUBE_ENABLED=true

# App
APP_HOST=0.0.0.0
APP_PORT=8742
SECRET_KEY=change-me-in-production
